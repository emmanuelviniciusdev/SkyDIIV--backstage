      "type": "timeseries",
      "title": "Scheduler route volume",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time(http_server_request_count{deployment_environment=\"$environment\",service_name=\"worker-scheduler\",http_route=\"/schedule/every-sunday\"}[$__interval]))",
          "legendFormat": "/schedule/every-sunday"
