    {
      "id": 1,
      "type": "text",
      "title": "Friday chain",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Search-terms workflow → robot batch → analyze-scraped-products are separate QStash hops (no shared trace). Panels below are independent series."
      }
