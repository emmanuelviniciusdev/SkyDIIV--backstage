    {
      "id": 14,
      "type": "timeseries",
      "title": "Profile picture saved vs removed",
      "description": "PUT persists a new avatar after presign + R2 PUT. DELETE clears it. Both hit /api/user/profile-picture.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
