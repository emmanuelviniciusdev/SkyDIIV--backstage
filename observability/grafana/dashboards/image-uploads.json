      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time(http_server_request_count{deployment_environment=\"$environment\",service_name=\"skydiiv-web\",http_route=\"/api/user/profile-picture\",http_request_method=\"PUT\",http_response_status_code=~\"2..\"}[$__interval]))",
          "legendFormat": "saved"
