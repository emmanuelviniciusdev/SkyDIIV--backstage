      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (count_over_time(http_server_request_count{deployment_environment=\"$environment\",service_name=\"skydiiv-web\",http_route=\"/api/upload/presign\"}[$__interval]))",
