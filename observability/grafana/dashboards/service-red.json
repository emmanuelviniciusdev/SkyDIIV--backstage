{
  "uid": "skydiiv-bs-service-red",
  "title": "SkyDIIV Backstage — Service RED",
  "tags": [
    "skydiiv",
    "backstage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "label": "Environment",
        "query": "production,staging,local",
        "current": {
          "selected": true,
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "selected": true,
            "text": "production",
            "value": "production"
          },
          {
            "selected": false,
            "text": "staging",
            "value": "staging"
          },
          {
            "selected": false,
            "text": "local",
            "value": "local"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "query": "worker-ai-workflows,worker-scheduler,worker-outbox-events,worker-notification,worker-sync,robot-scrape-products",
        "current": {
          "selected": true,
          "text": "worker-scheduler",
          "value": "worker-scheduler"
        },
        "options": [
          {
            "selected": false,
            "text": "worker-ai-workflows",
            "value": "worker-ai-workflows"
          },
          {
            "selected": true,
            "text": "worker-scheduler",
            "value": "worker-scheduler"
          },
          {
            "selected": false,
            "text": "worker-outbox-events",
            "value": "worker-outbox-events"
          },
          {
            "selected": false,
            "text": "worker-notification",
            "value": "worker-notification"
          },
          {
            "selected": false,
            "text": "worker-sync",
            "value": "worker-sync"
          },
          {
            "selected": false,
            "text": "robot-scrape-products",
            "value": "robot-scrape-products"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Volume",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time(http_server_request_count{deployment_environment=\"$environment\",service_name=\"$service\"}[$__interval])) or sum(count_over_time(batch_run_count{deployment_environment=\"$environment\",service_name=\"$service\"}[$__interval]))",
          "legendFormat": "$service"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Duration p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, http_server_request_duration{deployment_environment=\"$environment\",service_name=\"$service\"}[$__interval]) or quantile_over_time(0.95, batch_run_duration{deployment_environment=\"$environment\",service_name=\"$service\"}[$__interval])",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Status / batch status",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (count_over_time(http_server_request_count{deployment_environment=\"$environment\",service_name=\"$service\"}[$__interval]))",
          "legendFormat": "{{http_response_status_code}}"
        },
        {
          "refId": "B",
          "expr": "sum by (batch_status) (count_over_time(batch_run_count{deployment_environment=\"$environment\",service_name=\"$service\"}[$__interval]))",
          "legendFormat": "{{batch_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Error logs",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "DS_LOKI"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"$service\", deployment_environment=\"$environment\"} |= \"ERROR\""
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 5,
      "type": "traces",
      "title": "Traces",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "tempo",
        "uid": "DS_TEMPO"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\"}"
        }
      ]
    }
  ]
}
