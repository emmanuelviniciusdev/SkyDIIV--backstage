# =============================================================================
# Local development — copy to `.env` and fill in values.
#
#   cp .env.example .env
#
# Used by (all from this project directory):
#   - `npm run dev` / `npm run start:local`
#   - `docker compose up`
#   - `./scripts/publish-event.sh`
#   - `./deploy/deploy-from-local.sh` (default; override with --env-file)
#
# On the OCI VM the same keys are installed at:
#   /etc/skydiiv/consumer-shopping-suggestions.env
# For GitHub Actions CI, paste this file (prod values) into the Environment secret
#   CONSUMER_SHOPPING_SUGGESTIONS_ENV  — see docs/ENV.md
# See docs/ENV.md.
# =============================================================================

# Cloudflare Queues — default / required broker (HTTP pull + publish)
CF_ACCOUNT_ID=
CF_SCRAPE_SHOPP_SUGG_QUEUE_ID=
CF_QUEUES_API_TOKEN=
# Max messages per poll (default: 10)
CF_QUEUES_BATCH_SIZE=10
# Delay between polls in ms — use 60000 locally for faster feedback; production default is 600000 (10 min)
CF_QUEUES_POLL_INTERVAL_MS=60000
# Lease while processing a batch in ms (default: 7200000 = 2 hours)
CF_QUEUES_VISIBILITY_TIMEOUT_MS=7200000

# SkyDIIV web-app Redis — same instance the web app uses for cache + notifications
# Production (Upstash REST):
WEB_APP_REDIS_REST_URL=
WEB_APP_REDIS_REST_TOKEN=
# Local dev (plain Redis — same as web app REDIS_URL; Docker: use host.docker.internal):
# WEB_APP_REDIS_URL=redis://host.docker.internal:6379

# Postgres (required to persist scraped_products)
# Inside Docker Compose, host services are not "localhost" — use host.docker.internal:
# DATABASE_URL=postgresql://user:pass@host.docker.internal:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host:5432/dbname?sslmode=require

# Parallel message processing (default: 10; docker-compose overrides to 2)
CONSUMER_CONCURRENCY=10

# Human-like delay between scrape requests (milliseconds)
SCRAPE_DELAY_MIN_MS=800
SCRAPE_DELAY_MAX_MS=2500

# Camoufox / browser
CAMOUFOX_HEADLESS=true
CAMOUFOX_INSTALL_DIR=/opt/camoufox

# Outbound proxy pool — leave empty locally (infra writes this on the OCI VM)
# Example: socks5://127.0.0.1:11080,socks5://127.0.0.1:11081
PROXY_URLS=

# Logging
LOG_LEVEL=DEBUG
