# Redis Streams (message broker)
REDIS_URL=redis://127.0.0.1:6379
REDIS_STREAM_KEY=shopping-suggestions
REDIS_CONSUMER_GROUP=shopping-suggestions-consumers
REDIS_CONSUMER_NAME=consumer-1
REDIS_BLOCK_MS=5000
REDIS_CLAIM_IDLE_MS=60000

# Parallel message processing (default: 10)
CONSUMER_CONCURRENCY=10

# Human-like delay between scrape requests (milliseconds)
SCRAPE_DELAY_MIN_MS=800
SCRAPE_DELAY_MAX_MS=2500

# Camoufox / browser
CAMOUFOX_HEADLESS=true
CAMOUFOX_INSTALL_DIR=/opt/camoufox

# Outbound proxy pool (provisioned by infrastructure — never raw IPv6).
# On the Oracle VM this is written automatically by deploy/setup-proxy-pool.sh.
# Leave empty to disable proxy rotation (local development).
# Example: socks5://127.0.0.1:11080,socks5://127.0.0.1:11081
PROXY_URLS=

# Logging
LOG_LEVEL=INFO
