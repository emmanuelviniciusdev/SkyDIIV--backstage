# Local Docker Compose stack — copy to .env.docker and adjust if needed.
# Used by: docker compose --env-file .env.docker up

# Redis (service name in docker-compose.yml — internal port 6379, host port 6380)
REDIS_URL=redis://redis:6379
REDIS_STREAM_KEY=shopping-suggestions
REDIS_CONSUMER_GROUP=shopping-suggestions-consumers
REDIS_CONSUMER_NAME=consumer-1
REDIS_BLOCK_MS=5000
REDIS_CLAIM_IDLE_MS=60000

# Lower concurrency for local runs
CONSUMER_CONCURRENCY=2

SCRAPE_DELAY_MIN_MS=800
SCRAPE_DELAY_MAX_MS=2500

CAMOUFOX_HEADLESS=true
CAMOUFOX_INSTALL_DIR=/opt/camoufox

# No proxy rotation locally
PROXY_URLS=

LOG_LEVEL=DEBUG
