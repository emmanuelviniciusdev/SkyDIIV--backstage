# ── Used for local development (wrangler dev reads .dev.vars, not .env) ───────
# Copy this file to .dev.vars for local `wrangler dev` runs.
# Production secrets are set via: wrangler secret put <KEY>

# ── Upstash / QStash ─────────────────────────────────────────────────────────
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public ORIGIN of this Cloudflare Worker for Upstash Workflow step callbacks.
# Use WORKER_NOTIFICATION_URL.
# Only the scheme + host; serveMany appends each workflow path (e.g. /email--welcome).
# After first deploy: wrangler deployments list → copy the workers.dev URL
# e.g. https://worker-notification.<your-subdomain>.workers.dev
WORKER_NOTIFICATION_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# Neon pooled endpoint (pgbouncer) — for reads
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# Neon direct endpoint — for writes / transactions (user_notifications INSERT)
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# ── Email ─────────────────────────────────────────────────────────────────────
# Provider selector — resolves the transactional email provider (default: resend).
EMAIL_PROVIDER=resend
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Verified sender identity. Must match a verified domain in Resend.
EMAIL_FROM=no-reply@skydiiv.space
# Optional Reply-To header for user replies.
# EMAIL_REPLY_TO=contato@skydiiv.space

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL used to build CTA links in emails.
APP_URL=https://skydiiv.space
