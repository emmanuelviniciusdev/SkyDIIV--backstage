# ── Used for local development (wrangler dev reads .dev.vars, not .env) ───────
# Copy this file to .dev.vars for local `wrangler dev` runs.
# Production secrets are set via: wrangler secret put <KEY>

# ── Upstash / QStash ─────────────────────────────────────────────────────────
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public ORIGIN of this Cloudflare Worker for Upstash Workflow step callbacks.
# Use WORKER_SYNC_URL.
# Only the scheme + host; serveMany appends each workflow path (e.g. /sync/language).
# After first deploy: wrangler deployments list → copy the workers.dev URL
# e.g. https://worker-sync.<your-subdomain>.workers.dev
WORKER_SYNC_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# Neon pooled endpoint (pgbouncer) — for reads
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# Neon direct endpoint — for writes / transactions
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini_flash
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_URL=

# ── Observability (Grafana Cloud OTLP) ────────────────────────────────────────
# See docs/OBSERVABILITY.md. Unset credentials → noop (console NDJSON only).
# Key source for field encryption. production / staging → key database.
# local or unset → local test vectors. See docs/FIELD_ENCRYPTION.md.
DEPLOYMENT_ENVIRONMENT=local

# ── Field encryption (encryption_keys) ────────────────────────────────────────
# Secrets. Required when DEPLOYMENT_ENVIRONMENT is production or staging.
# Not used for local / tests. Do not set ENCRYPTION_KEY_SOURCE.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_ENCRYPTION_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
