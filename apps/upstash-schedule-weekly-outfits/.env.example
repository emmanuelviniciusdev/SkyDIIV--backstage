# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Upstash QStash ─────────────────────────────────────────────────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Weekly Outfits Worker ──────────────────────────────────────────────────────
# Public URL of the Cloudflare Worker that runs the Upstash Workflow.
# QStash will POST { userId } to this URL for each eligible user.
# Production:  https://weekly-outfits-worker.<your-subdomain>.workers.dev
# Staging:     https://weekly-outfits-worker-staging.<your-subdomain>.workers.dev
WEEKLY_OUTFITS_WORKER_URL=https://weekly-outfits-worker.<your-subdomain>.workers.dev

# ── Local development only ─────────────────────────────────────────────────────
# Copy this file to .dev.vars (gitignored) and fill in the values.
# wrangler dev reads .dev.vars automatically.
