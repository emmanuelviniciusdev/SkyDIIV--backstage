# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Upstash QStash ─────────────────────────────────────────────────────────────
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public ORIGIN of this Cloudflare Worker for Upstash Workflow step callbacks.
# Use WORKER_OUTBOX_EVENTS_URL.
# Only the scheme + host; serveMany appends each workflow path (e.g. /process-outbox-event).
# After first deploy: wrangler deployments list → copy the workers.dev URL
# e.g. https://worker-outbox-events.<your-subdomain>.workers.dev
WORKER_OUTBOX_EVENTS_URL=https://worker-outbox-events.<your-subdomain>.workers.dev

# ── Upstash Redis ──────────────────────────────────────────────────────────────
# Used to hold the processing lock per outbox event (prevents concurrent duplicate dispatches).
# Option A: REST credentials (preferred)
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Option B: standard Upstash Redis URL (alternative to Option A)
# REDIS_URL=rediss://default:<token>@<your-db>.upstash.io:6379

# ── Downstream workers ─────────────────────────────────────────────────────────
# Worker origins (no path). The handler appends the endpoint path automatically:
#   sync-language          → {WORKER_SYNC_URL}/sync/language
#   generate-weekly-outfits → {WORKER_AI_WORKFLOWS_URL}/generate-weekly-outfits
# Production:  https://worker-sync.<your-subdomain>.workers.dev
# Staging:     https://worker-sync-staging.<your-subdomain>.workers.dev
WORKER_SYNC_URL=https://worker-sync.<your-subdomain>.workers.dev
WORKER_AI_WORKFLOWS_URL=https://worker-ai-workflows.<your-subdomain>.workers.dev

# ── Local development only ─────────────────────────────────────────────────────
# Copy this file to .dev.vars (gitignored) and fill in the values.
# wrangler dev reads .dev.vars automatically.
