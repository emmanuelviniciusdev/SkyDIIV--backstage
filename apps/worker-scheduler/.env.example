# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Upstash QStash ─────────────────────────────────────────────────────────────
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Flow: Weekly Outfits ─────────────────────────────────────────────────────
# Full endpoint URL of the worker-ai-workflows generate-weekly-outfits workflow.
# QStash POSTs { userId } to this URL (path included) for each eligible user.
# Production:  https://worker-ai-workflows.<your-subdomain>.workers.dev/generate-weekly-outfits
# Staging:     https://worker-ai-workflows-staging.<your-subdomain>.workers.dev/generate-weekly-outfits
WEEKLY_OUTFITS_WORKER_URL=https://worker-ai-workflows.<your-subdomain>.workers.dev/generate-weekly-outfits

# ── Flow: Wardrobe Panorama ──────────────────────────────────────────────────
# Full endpoint URL of the worker-ai-workflows generate-wardrobe-panorama workflow.
# QStash POSTs { userId } to this URL (path included) for each eligible user.
# Production:  https://worker-ai-workflows.<your-subdomain>.workers.dev/generate-wardrobe-panorama
# Staging:     https://worker-ai-workflows-staging.<your-subdomain>.workers.dev/generate-wardrobe-panorama
WARDROBE_PANORAMA_WORKER_URL=https://worker-ai-workflows.<your-subdomain>.workers.dev/generate-wardrobe-panorama

# ── Local development only ─────────────────────────────────────────────────────
# Copy this file to .dev.vars (gitignored) and fill in the values.
# wrangler dev reads .dev.vars automatically.
