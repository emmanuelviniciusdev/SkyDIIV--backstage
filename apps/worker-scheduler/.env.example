# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Upstash QStash ─────────────────────────────────────────────────────────────
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── worker-ai-workflows ────────────────────────────────────────────────────────
# Worker origin (no path). Flows append their endpoint path automatically:
#   weekly-outfits            → {WORKER_AI_WORKFLOWS_URL}/generate-weekly-outfits
#   generate-wardrobe-panorama → {WORKER_AI_WORKFLOWS_URL}/generate-wardrobe-panorama
# Production:  https://worker-ai-workflows.<your-subdomain>.workers.dev
# Staging:     https://worker-ai-workflows-staging.<your-subdomain>.workers.dev
WORKER_AI_WORKFLOWS_URL=https://worker-ai-workflows.<your-subdomain>.workers.dev

# Upstash Redis REST credentials (shared with the SkyDIIV web app).
# Used by generate-wardrobe-panorama to filter users with a pending wardrobe update marker.
# Alternatively, set REDIS_URL to a standard Upstash rediss:// URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ── Local development only ─────────────────────────────────────────────────────
# Copy this file to .dev.vars (gitignored) and fill in the values.
# wrangler dev reads .dev.vars automatically.
