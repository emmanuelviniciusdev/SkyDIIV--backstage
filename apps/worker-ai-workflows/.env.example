# ── Used for local development (wrangler dev reads .dev.vars, not .env) ───────
# Copy this file to .dev.vars for local `wrangler dev` runs.
# Production secrets are set via: wrangler secret put <KEY>

# ── Upstash / QStash ─────────────────────────────────────────────────────────
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public ORIGIN of this Cloudflare Worker for Upstash Workflow step callbacks.
# Only the scheme + host; serveMany appends each workflow path automatically.
# After first deploy: wrangler deployments list → copy the workers.dev URL
# e.g. https://worker-ai-workflows.<your-subdomain>.workers.dev
WORKER_AI_WORKFLOWS_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# Neon pooled endpoint (pgbouncer) — for reads
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# Neon direct endpoint — for writes / transactions
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini_flash
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ── Outbox (worker-outbox-events → CF Queues) ──────────
# Origin of worker-outbox-events (no path). Appends /process-outbox-event.
WORKER_OUTBOX_EVENTS_URL=https://worker-outbox-events.<your-subdomain>.workers.dev

# ── R2 / image storage (outfit thumbnails) ────────────────────────────────────
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# R2_ENDPOINT=  # optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
