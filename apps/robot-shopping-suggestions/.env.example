# =============================================================================
# Local development — copy to `.env` and fill in values.
#
#   cp .env.example .env
#
# Used by:
#   - `npm run dev` / `npm run start:local`
#   - `docker compose up`
#   - `./scripts/publish-event.sh`
#
# For GitHub Actions weekly create, paste prod values into the Environment secret
#   ROBOT_SHOPPING_SUGGESTIONS_ENV  — see docs/ENV.md
#
# Local terraform apply uses this same .env automatically (deploy-from-local.sh).
# =============================================================================

# Cloudflare Queues — required broker (HTTP pull + publish)
CF_ACCOUNT_ID=
CF_SCRAPE_SHOPP_SUGG_QUEUE_ID=
CF_QUEUES_API_TOKEN=
# Max messages per pull (robot default: 2)
CF_QUEUES_BATCH_SIZE=2
# Lease while processing a batch in ms (default: 7200000 = 2 hours)
CF_QUEUES_VISIBILITY_TIMEOUT_MS=7200000

# SkyDIIV web-app Redis
WEB_APP_REDIS_REST_URL=
WEB_APP_REDIS_REST_TOKEN=
# WEB_APP_REDIS_URL=redis://host.docker.internal:6379

# Postgres
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host:5432/dbname?sslmode=require

# Parallel message processing within a pull (default: 2)
ROBOT_CONCURRENCY=2

SCRAPE_DELAY_MIN_MS=800
SCRAPE_DELAY_MAX_MS=2500

CAMOUFOX_HEADLESS=true
CAMOUFOX_INSTALL_DIR=/opt/camoufox

# Optional outbound proxies
PROXY_URLS=

# OCI self-delete — leave empty locally (noop). Injected by Terraform in production.
# COMPUTE_PROVIDER=oci
# OCI_CONTAINER_INSTANCE_OCID=
# OCI_COMPARTMENT_OCID=
# ROBOT_DISPLAY_NAME=
# OCI_REGION=us-ashburn-1
# OCI_TENANCY_OCID=
# OCI_USER_OCID=
# OCI_FINGERPRINT=
# OCI_API_PRIVATE_KEY=
# Self-delete only works from ACTIVE; these bound the wait for that transition.
# SELF_DELETE_WAIT_ACTIVE_MS=240000
# SELF_DELETE_POLL_INTERVAL_MS=5000
# SELF_DELETE_ACTIVE_GRACE_MS=120000

LOG_LEVEL=DEBUG
