# Copy to deploy/local.env (gitignored). Used by deploy-from-local.sh.
#
#   cp deploy/local.env.example deploy/local.env
#
# apply = docker login + build linux/arm64 + push OCIR + terraform apply

# Full OCIR image URL (script builds & pushes this tag)
TF_VAR_container_image_url="us-ashburn-1.ocir.io/YOUR_OCIR_NAMESPACE/robot-shopping-suggestions:local"

# OCIR credentials (same as docker login)
TF_VAR_ocir_username="YOUR_OCIR_NAMESPACE/you@example.com"
TF_VAR_ocir_auth_token="YOUR_AUTH_TOKEN"

# Optional
# IMAGE_PLATFORM=linux/arm64
# COST_LIMIT_USD=5
# TF_VAR_network_mode=private            # public (default) | private (NAT + Service Gateway)
# TF_VAR_ocir_registry_endpoint=us-ashburn-1.ocir.io  # override the derived <host>/<namespace>
# GITHUB_TOKEN=$(gh auth token)          # avoids GitHub API rate limits during docker build (camoufox fetch)
# TF_BACKEND_HCL=deploy/terraform/backend.hcl  # required unless deploy/terraform/backend.hcl exists (auto-detected)
