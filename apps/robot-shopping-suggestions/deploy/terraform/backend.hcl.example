# OCI Object Storage (S3-compatible API) remote state.
# Copy to backend.hcl (gitignored), fill in, then either:
#
#   Recommended for GitHub Actions (preserves quotes/newlines exactly):
#     base64 < backend.hcl | gh secret set TF_BACKEND_HCL_B64 --env production
#
#   Local deploy/local.env:
#     TF_BACKEND_HCL=deploy/terraform/backend.hcl

bucket   = "YOUR_BUCKET_NAME"
key      = "robot-shopping-suggestions/production.tfstate"
region   = "us-ashburn-1"
endpoint = "https://YOUR_NAMESPACE.compat.objectstorage.us-ashburn-1.oraclecloud.com"

access_key = "YOUR_CUSTOMER_SECRET_ACCESS_KEY"
secret_key = "YOUR_CUSTOMER_SECRET_SECRET_KEY"

# The S3 driver targets AWS by default; these disable the AWS-only calls and the
# aws-chunked upload encoding that OCI Object Storage answers with 501.
skip_region_validation      = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true
