# ── Used for local development (wrangler dev reads .dev.vars, not .env) ───────
# Copy this file to .dev.vars for local `wrangler dev` runs.
# Production secrets are set via: wrangler secret put <KEY>

# ── Upstash / QStash ─────────────────────────────────────────────────────────
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public URL of this Cloudflare Worker (used by @upstash/workflow for callbacks)
# After first deploy: wrangler deployments list → copy the workers.dev URL
UPSTASH_WORKFLOW_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# Neon pooled endpoint (pgbouncer) — for reads
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# Neon direct endpoint — for writes / transactions
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini_flash
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_URL=

# ── Cloudflare R2 / Image storage ──────────────────────────────
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for generated outfit images
R2_PUBLIC_URL=
# Optional: override the R2 S3-compatible endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
