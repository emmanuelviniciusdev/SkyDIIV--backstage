# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

R2_BUCKET=skydiiv--production--assets

# Public origin used to build the Cache Purge prefix (no trailing slash).
R2_PUBLIC_URL=https://assets.skydiiv.space

# Zone → Cache Purge (not the Wrangler deploy token unless it has this permission).
CLOUDFLARE_API_TOKEN=
# Zone id for skydiiv.space (parent of assets.skydiiv.space)
CLOUDFLARE_ZONE_ID=
