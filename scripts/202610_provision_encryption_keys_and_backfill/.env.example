# Cloudflare D1 — operator token with D1 edit. Do not reuse the worker query token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_API_TOKEN=

# Optional for provision (printed/verified). Backfill looks up the database by
# name when unset. After provision, set this on web and on worker GitHub
# Environments staging / production BEFORE running backfill.
CLOUDFLARE_D1_ENCRYPTION_DATABASE_ID=

# Optional. Staging and production share this D1 so staging can open rows
# web staging sealed. Do not create a second database for staging.
D1_DATABASE_NAME=skydiiv--production

# preferred — bypasses the connection pooler (backfill)
DATABASE_URL_UNPOOLED="postgresql://user:pass@host:5432/dbname"

# fallback if the above is not set (backfill)
DATABASE_URL="postgresql://user:pass@host:5432/dbname"
