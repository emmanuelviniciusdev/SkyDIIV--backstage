# preferred — bypasses the connection pooler
DATABASE_URL_UNPOOLED="postgresql://user:pass@host:5432/dbname"

# fallback if the above is not set
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# QStash + worker-outbox-events (origin only — the script appends /process-outbox-event)
QSTASH_TOKEN=
# QSTASH_URL=https://qstash.upstash.io
WORKER_OUTBOX_EVENTS_URL=https://worker-outbox-events.<your-subdomain>.workers.dev
