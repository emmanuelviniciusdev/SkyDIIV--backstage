# Database (prefer unpooled for long-running scripts)
DATABASE_URL_UNPOOLED="postgresql://user:pass@host:5432/dbname"
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

R2_SOURCE_BUCKET=skydiiv-clothing-pieces
R2_DEST_BUCKET=skydiiv--production--assets

# Public base used when rewriting clothing_items.image_url paths.
# Example: https://assets.skydiiv.space  or  https://pub-xxxxx.r2.dev
R2_PUBLIC_URL=
